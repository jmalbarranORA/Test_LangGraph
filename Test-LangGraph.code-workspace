{
	"folders": [
		{
			"path": "."
		}
	],
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python:Current file",
				"type": "debugpy",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal"
			},
			{
				"name": "Python:Streamlit",
				"type": "debugpy",
				"request": "launch",
				"module": "streamlit",
				"args": [
					"run",
					"${file}",
					"--server.port",
					"8501"
				]
			},
		]
	}
}